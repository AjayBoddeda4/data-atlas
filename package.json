{
  "name": "data-atlas-portable",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/seo.ts",
    "build:local": "vite build --mode standalone",
    "start": "npm run build:local && node server/server.ts",
    "scan": "node scripts/scan.ts",
    "publish:data": "node scripts/publish-data.ts",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  }
}
